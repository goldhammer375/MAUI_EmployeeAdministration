<?xml version="1.0" encoding="UTF-8" ?>
<Shell
	x:Class="FrontEnd.AppShell"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:FrontEnd"
	xmlns:pages="clr-namespace:FrontEnd.Pages"
	Title="FrontEnd">

	<ShellContent
		Title="Employees"
		ContentTemplate="{DataTemplate pages:HomePage}"
		Route="EmployeesPage" />

	<ShellContent
		Title="Departments"
		ContentTemplate="{DataTemplate pages:DepartmentPage}"
		Route="DepartmentsPage" />

	<ShellContent
		Title="Offices"
		ContentTemplate="{DataTemplate pages:OfficePage}"
		Route="OfficesPage" />

</Shell>
