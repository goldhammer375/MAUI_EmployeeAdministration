<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="FrontEnd.Pages.OfficePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:FrontEnd.Resources.CustomControls"
	Title="OfficePage">
	<Grid RowDefinitions="Auto, *">
		<HorizontalStackLayout Padding="10" Spacing="10">
			<Button Command="{Binding CreateOfficeCommand}" Text="Nueva oficina" />
		</HorizontalStackLayout>
		<CollectionView
			Grid.Row="1"
			ItemsSource="{Binding Offices}"
			SelectedItem="{Binding SelectedOffice}"
			SelectionChangedCommand="{Binding GoToDetailCommand}"
			SelectionMode="Single">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<controls:OfficeCard Margin="5" BindingContext="{Binding .}" />
				</DataTemplate>
			</CollectionView.ItemTemplate>
			<CollectionView.ItemsLayout>
				<GridItemsLayout x:Name="OfficeCollection" Orientation="Vertical" />
			</CollectionView.ItemsLayout>
		</CollectionView>
	</Grid>
</ContentPage>