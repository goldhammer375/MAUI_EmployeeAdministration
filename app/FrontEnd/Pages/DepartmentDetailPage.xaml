<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="FrontEnd.Pages.DepartmentDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:FrontEnd.Resources.CustomControls"
	Title="DepartmentDetailPage">
	<VerticalStackLayout Padding="250,0">

		<Grid Margin="0,15" ColumnDefinitions="Auto, *">
			<Label Padding="10" Text="Nombre:" />
			<Entry
				Grid.Column="1"
				Placeholder="Nombre del departamento"
				Text="{Binding Department.Name}" />
		</Grid>

		<Grid ColumnDefinitions="*, *">
			<Button
				Margin="20"
				Command="{Binding SaveCommand}"
				Text="Guardar Cambios" />
			<Button
			Grid.Column="1"
				Margin="20"
				Command="{Binding DeleteCommand}"
				Text="Borrar" />
		</Grid>

	</VerticalStackLayout>
</ContentPage>